{
  "dataset": "tos-scenarios",
  "version": "1.0",
  "description": "Labelled evaluation scenarios for Titan Operations Sentinel. Each case carries an input alert, deterministic fixtures for the tool layer, and the expected routing, tool calls, gate decisions and plan tiers. The offline harness (eval/policy_eval.py) scores the real tools plus the code-enforced policy against these labels with no model and no key. The live harness (eval/live_eval.py) runs the full agent graph on a subset and scores tool-call correctness, citation rate, tokens and latency against the same labels.",
  "labelling_note": "Labels were written from the documented policy (policy.py, docs/appendix/*, CLAUDE.md section 5), not from observed output. Where the implementation disagrees with the label, the scorecard reports a miss rather than the label being changed to match.",
  "scenarios": [
    {
      "id": "S01-cascade-baseline",
      "title": "Friday Cascade: rising spindle vibration, parts gap, expedite over ceiling",
      "challenges": [
        1,
        2,
        3,
        4,
        5
      ],
      "mode": "happy",
      "in_live_subset": true,
      "alert": {
        "alert_id": "ALT-22847",
        "machine_id": "CNC-07-LEI",
        "plant_id": "LEI",
        "sensor": "vibration",
        "value": 7.2,
        "unit": "mm/s_RMS",
        "threshold": 6.0,
        "trend": "rising",
        "baseline": 3.1,
        "trend_window": "6h",
        "production_impact_per_day_eur": 180000
      },
      "fixture": {
        "readings": {
          "vibration": 7.2,
          "bearing_temp": 78.4
        },
        "telemetry_status": "OK",
        "sourcing": {
          "failure_window_hours": 52,
          "downtime_cost_per_hour": 7500,
          "options": [
            {
              "label": "Schaeffler air freight expedite",
              "cost_eur": 3200,
              "lead_time_hours": 18,
              "risk_level": "LOW"
            },
            {
              "label": "Standard road freight",
              "cost_eur": 180,
              "lead_time_hours": 96,
              "risk_level": "LOW"
            }
          ]
        },
        "proposed_actions": [
          "reduce spindle speed to OEM safe limit",
          "reroute production jobs to equivalent machines",
          "authorize an emergency parts purchase",
          "open the machine for emergency maintenance and bearing replacement in a Saturday window"
        ]
      },
      "expected": {
        "risk": "HIGH",
        "escalates": false,
        "needs_approval": true,
        "safety_verdict": "ESCALATE",
        "halt": false,
        "terminal_status": "complete",
        "agents_required": [
          "reliability",
          "supply_chain",
          "production",
          "quality",
          "compliance_safety"
        ],
        "action_tiers": [
          "AUTO",
          "AUTO",
          "APPROVE",
          "APPROVE"
        ],
        "tool_calls": {
          "reliability": [
            "alert_triage",
            "sensor_query",
            "rul_predictor"
          ],
          "supply_chain": [
            "parts_inventory",
            "supplier_catalog",
            "expedite_cost"
          ],
          "production": [
            "job_reroute"
          ],
          "quality": [
            "quality_history"
          ],
          "compliance_safety": [
            "safety_gate"
          ]
        }
      }
    },
